{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peek Desktop",
  "version": "0.3.2",
  "identifier": "local.peek.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Peek Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1430 ws://127.0.0.1:1430; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "kasen",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 kasen",
    "homepage": "https://github.com/lx8s8/peek-desktop",
    "shortDescription": "Flutter network and log inspector",
    "longDescription": "View Flutter network requests, Talker logs and exception stacks. Save sessions, export HAR and restore offline workspaces.",
    "fileAssociations": [
      {
        "ext": [
          "peek"
        ],
        "name": "Peek network session",
        "description": "Peek network session",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "peekbundle"
        ],
        "name": "Peek Desktop archive",
        "description": "Peek Desktop session archive",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "local.peek.desktop.archive",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "license": "MIT",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    }
  }
}
