{
  "name": "peek-desktop",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts scripts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:test": "node --test scripts/*.test.mjs",
    "package:local": "node scripts/package-desktop.mjs unsigned",
    "updater:key": "node scripts/create-updater-key.mjs",
    "notices:generate": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.1",
    "lossless-json": "^4.3.3",
    "lucide-react": "^1.72.0",
    "qrcode.react": "4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^18.0.1",
    "react-resizable-panels": "^4.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vanilla-jsoneditor": "^3.13.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^25",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
